{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "purnata-svelte-osint",
  "version": "0.1.0",
  "identifier": "com.yeshaya.purnata-svelte-osint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OSINT Investigation",
        "width": 800,
        "height": 600,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      
    }
  },
  "bundle": {
    
  },
  "plugins": {
    "deep-link": {
      "schemes": ["com.yeshaya.purnata-svelte-osint"]
    }
  }
}